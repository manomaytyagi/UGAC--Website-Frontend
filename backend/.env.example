# ── Database (Neon) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host:5432/neondb?ssl=require

# ── Redis (Upstash) ──────────────────────────────────────────────────────────
REDIS_URL="https://your-upstash-redis-url"
REDIS_TOKEN=your-upstash-redis-token

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_32_char_random_string
ADMIN_USERNAME=ugac_admin
ADMIN_PASSWORD_HASH=replace_with_hash_of_strong_password

# ── Storage ──────────────────────────────────────────────────────────────────
# AWS S3 (prod): leave STORAGE_ENDPOINT empty, set bucket + region.
# If using ECS task-role IAM perms, omit ACCESS/SECRET keys entirely.
# MinIO (dev):   set STORAGE_ENDPOINT=http://localhost:9000
# Local FS:      set STORAGE_ENDPOINT=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=ugac-files
AWS_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origins allowed to call this API
CORS_ORIGINS=["https://ugac.iitmandi.ac.in","https://<frontend-deploy-domain>"]

HCAPTCHA_SECRET_KEY=your_secret_key_here
TRUST_PROXY_CIDR=your_trusted_proxy_cidr_here
